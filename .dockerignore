# Secrets never in the image
**/.env

# Runtime / build artefacts
**/__pycache__/
**/*.pyc
**/.pytest_cache/
**/.ruff_cache/

# Frontend deps + build outputs — the Node build stage rebuilds the SPA from source
frontend/node_modules/
frontend/dist/
frontend/dist-element/
frontend/.angular/

# Not needed in the image (tests, dev tooling, deploy/CI/docs, Vercel)
backend/tests/
backend/requirements-dev.txt
backend/pytest.ini
backend/api/
deploy/
.git/
.github/
.gitignore
.dockerignore
Dockerfile
vercel.json
*.md
