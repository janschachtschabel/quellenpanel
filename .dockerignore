# Secrets never in the image
**/.env

# Runtime / build artefacts
**/__pycache__/
**/*.pyc
**/.pytest_cache/
**/.ruff_cache/

# Frontend deps + build outputs — the Node build stage rebuilds the SPA from source
frontend/node_modules/
frontend/dist/
frontend/dist-element/
frontend/dist-widgets/
frontend/.angular/

# Not needed in the image (tests, dev tooling, deploy/CI/docs)
backend/tests/
backend/requirements-dev.txt
backend/pytest.ini
deploy/
.git/
.github/
.gitignore
.dockerignore
*.md

# Data never goes into the image: the team instance seeds/builds it in $QE_DATA_DIR at runtime
backend/data/truth.json
backend/data/raw/
backend/data/exports/
backend/data/status.json
backend/data/session.key
profiles/*/daten/
