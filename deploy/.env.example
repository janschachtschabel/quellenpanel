# Copy to deploy/.env and adjust. Used by docker-compose.yml (HTTP) and docker-compose.tls.yml (HTTPS).
# Both start three instances from one image: team (tier 2), partner (tier 1), public (tier 0).

# Required: the published image to run (pin a version, not latest).
IMAGE=youruser/quellenpanel:0.3.0
# Host ports (HTTP variant). The team port is bound to 127.0.0.1 only.
PORT=8080
PARTNER_PORT=8081
TEAM_PORT=8082

# --- Team instance ---
# Tier 2 login; unset = no team access (fail-closed).
QE_TEAM_PASSWORD=
# HMAC key for team sessions, e.g. `openssl rand -hex 32`. Unset = logins end on every restart.
QE_SESSION_SECRET=
# First start with an empty data volume: base URL with crawler.csv, korrekturen.csv, truth.json.
# Empty = build from the live repository (the API answers 503 "Daten werden aufgebaut" meanwhile).
QE_SEED_URL=
# Optional nightly rebuild (hour 0–23; empty = off).
QE_AUTO_REFRESH_HOUR=
# Cross-origin team login (embedded widget on another origin), comma-separated; requires HTTPS.
QE_ALLOWED_ORIGINS=

# --- Partner instance ---
# Password for tier 1 (Steckbrief); unset = tier 1 stays closed on the partner instance.
QE_TIER1_PASSWORD=
# How often partner/public re-fetch their export from the team (minutes).
QE_EXPORT_POLL_MINUTES=10

# --- Repository neutrality (defaults = production) ---
QE_REPO_URL=https://redaktion.openeduhub.net
QE_SEARCH_URL=https://suche.wirlernenonline.de

# --- HTTPS variant only (docker-compose.tls.yml) ---
# Hostnames via nip.io/sslip.io: <label>.<YOUR-SERVER-IP>.nip.io (the IP keeps its dots).
SITE_ADDRESS=quellen.31.70.69.94.nip.io
PARTNER_ADDRESS=steckbrief.31.70.69.94.nip.io
