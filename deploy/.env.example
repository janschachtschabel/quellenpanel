# Copy to deploy/.env and adjust. Used by docker-compose.yml (HTTP) and docker-compose.tls.yml (HTTPS).

# Required: the published image to run.
IMAGE=youruser/quellenpanel:latest
# Host port to expose (container always listens on 8080).
PORT=8080

# --- Access tiers (all optional; unset = end-user-only, fail-closed) ---
QE_TEAM_PASSWORD=
QE_TIER1_PASSWORD=
QE_PUBLIC_ONLY=
# Cross-origin team login (embedded widget on another origin): comma-separated origins allowed to
# use the credentialed session cookie. Empty = team login is same-origin only. Requires HTTPS.
# Example: QE_ALLOWED_ORIGINS=https://wirlernenonline.de,https://www.wirlernenonline.de
QE_ALLOWED_ORIGINS=

# --- Operations ---
QE_AUTO_REFRESH_HOUR=

# --- Repository neutrality (defaults = production) ---
QE_REPO_URL=https://redaktion.openeduhub.net
QE_SEARCH_URL=https://suche.wirlernenonline.de

# --- HTTPS variant only (docker-compose.tls.yml) ---
# Hostname via nip.io/sslip.io: <label>.<YOUR-SERVER-IP>.nip.io (the IP keeps its dots).
SITE_ADDRESS=quellenpanel.31.70.69.94.nip.io
