# Caddy fetches a Let's Encrypt certificate for $SITE_ADDRESS and redirects HTTP -> HTTPS.
# The hostname comes from .env (SITE_ADDRESS), e.g. quellenpanel.31.70.69.94.nip.io
{$SITE_ADDRESS} {
	reverse_proxy quellenpanel:8080 {
		# Overwrite X-Forwarded-For with the REAL client IP (discarding any value the client sent),
		# so the app's per-client rate limits key on a trusted, unspoofable value. Paired with
		# uvicorn's --forwarded-allow-ips in docker-compose.tls.yml.
		header_up X-Forwarded-For {remote_host}
	}
}
