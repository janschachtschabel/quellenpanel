# Caddy fetches Let's Encrypt certificates and redirects HTTP -> HTTPS. Hostnames come from .env:
#   SITE_ADDRESS     public instance (tier 0), e.g. quellen.31.70.69.94.nip.io
#   PARTNER_ADDRESS  partner instance (tier 1), e.g. steckbrief.31.70.69.94.nip.io
# Only port 8080 of each instance is proxied; the internal port is never exposed.
# X-Forwarded-For is OVERWRITTEN with the real client IP (any client value is discarded), which is
# what TRUST_PROXY=1 in docker-compose.tls.yml relies on.
{$SITE_ADDRESS} {
	reverse_proxy public:8080 {
		header_up X-Forwarded-For {remote_host}
	}
}

{$PARTNER_ADDRESS} {
	reverse_proxy partner:8080 {
		header_up X-Forwarded-For {remote_host}
	}
}
