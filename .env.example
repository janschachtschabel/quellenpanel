# Settings for docker-compose.yml (server behind a Traefik proxy). Every field may stay empty:
# the first deploy works without any value. Reachable then: http://SERVER-IP:18080 (public list).
# Never commit real passwords; fill them in only on the server.

# --- Addresses (plain host names, no https://) ---
# Public source list and widgets, e.g. quellen.example.org. Without an own domain:
# quellen.<SERVER-IP>.sslip.io (the IP keeps its dots) also gets a certificate.
DOMAIN=
# Partner instance (Steckbrief, tier 1). Empty: not reachable.
PARTNER_DOMAIN=
# Team instance (audit, corrections). Empty: not reachable, which is the safe default.
# Set it only for tests or behind VPN/SSO, and always together with QE_TEAM_PASSWORD.
TEAM_DOMAIN=

# --- Ports for direct access without a domain (http://SERVER-IP:PORT) ---
# Change them if another app already uses one. Empty: 18080, 18081, 18082.
# Every instance is its own container, so each needs its own port (e.g. 8090, 8091, 8092).
PORT=
PARTNER_PORT=
TEAM_PORT=
# Address the team port listens on. Empty: 127.0.0.1 (this server only). 0.0.0.0 opens it to
# everyone: only for tests and only with a long QE_TEAM_PASSWORD.
TEAM_BIND=

# --- Passwords ---
# Team login (tier 2). Empty: no team access. Long and random, e.g. openssl rand -base64 18
QE_TEAM_PASSWORD=
# Partner password for tier 1 (partner and team instance). Empty: tier 1 stays closed on the
# partner instance, but is open on the team instance to anyone who reaches it.
QE_TIER1_PASSWORD=
# Key for team sessions. Empty: created once in the data volume.
QE_SESSION_SECRET=

# --- Data ---
# Starting copies of korrekturen.csv and crawler.csv for an empty volume.
# Empty: the copies in this repository (profiles/wlo/daten).
QE_SEED_URL=
# Hour (0-23, UTC) of the nightly data rebuild. Empty: 3. "aus" switches it off.
QE_AUTO_REFRESH_HOUR=
# How often partner and public fetch their export from the team (minutes). Empty: 10.
QE_EXPORT_POLL_MINUTES=

# --- Proxy (empty = the usual names) ---
# Docker network shared with the proxy. Empty: quellenpanel-web (created if missing).
TRAEFIK_NETWORK=
# Entry point for HTTPS. Empty: websecure.
TRAEFIK_ENTRYPOINT=
# Certificate resolver. Empty: letsencrypt.
TRAEFIK_CERTRESOLVER=

# --- Source of the build (empty = this repository, branch main) ---
# e.g. https://github.com/<owner>/quellenpanel.git#v1.0.0 for a fixed version.
QE_GIT_URL=
