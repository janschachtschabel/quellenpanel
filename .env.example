# Settings for docker-compose.yml (server behind a Traefik proxy). Every field may stay empty:
# the first deploy works without any value. Reachable then: http://SERVER-IP:18080.
# One instance on one port serves every tier; tier 1 and 2 need their passwords.
# Never commit real passwords; fill them in only on the server.

# --- Address and port ---
# Plain host name, no https://, e.g. quellen.example.org. Without an own domain:
# quellen.<SERVER-IP>.sslip.io (the IP keeps its dots) also gets a certificate.
DOMAIN=
# Port for direct access without a domain (http://SERVER-IP:PORT). Empty: 18080.
PORT=
# Address the port listens on. Empty: 0.0.0.0 (everyone). 127.0.0.1: this server only.
BIND=

# --- Passwords (empty = that tier stays closed) ---
# Tier 1 (Steckbrief, details). Long and random, e.g. openssl rand -base64 18
QE_TIER1_PASSWORD=
# Tier 2 (audit, corrections). Long and random, different from the tier-1 password.
QE_TEAM_PASSWORD=
# Key for team sessions. Empty: created once in the data volume.
QE_SESSION_SECRET=

# --- Optional: separate instances ---
# 1 starts two more instances that only hold their tier export, so the public server never
# stores internal data. Then set BIND=127.0.0.1 and leave DOMAIN empty (or behind VPN/SSO).
# Empty: off (one instance is enough).
SEPARATE_INSTANCES=
# Partner instance (tier 0/1): host name and port. Empty: no domain, port 18081.
PARTNER_DOMAIN=
PARTNER_PORT=
# Public instance (tier 0): host name and port. Empty: no domain, port 18082.
PUBLIC_DOMAIN=
PUBLIC_PORT=

# --- Repository (empty = WirLernenOnline, profile wlo) ---
# Profile under profiles/<name> in this repository (properties, vocabulary, crawler table).
QE_PROFILE=
# edu-sharing repository and public search. Empty: the URLs of the profile.
QE_REPO_URL=
QE_SEARCH_URL=

# --- Data ---
# Starting copies of korrekturen.csv and crawler.csv for an empty volume.
# Empty: the copies in this repository (profiles/wlo/daten). With another profile, point it to
# that profile's daten folder (or upload both files in the team area).
QE_SEED_URL=
# Hour (0-23, UTC) of the nightly data rebuild. Empty: 3. "aus" switches it off.
QE_AUTO_REFRESH_HOUR=
# Separate instances only: how often they fetch their export (minutes). Empty: 10.
QE_EXPORT_POLL_MINUTES=

# --- Proxy (empty = the usual names) ---
# Docker network shared with the proxy. Empty: quellenpanel-web (created if missing).
TRAEFIK_NETWORK=
# Entry point for HTTPS. Empty: websecure.
TRAEFIK_ENTRYPOINT=
# Certificate resolver. Empty: letsencrypt.
TRAEFIK_CERTRESOLVER=

# --- Version (empty = newest image of main, pulled on every deploy) ---
# Only for a fixed release, e.g. QE_VERSION=1.0.1 (the version without "v").
QE_VERSION=
